# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# In Expo, only variables prefixed with EXPO_PUBLIC_ are exposed to app code.
# Anything here ships inside the app bundle — never put a true secret in this
# file. (IGDB's client_secret is the reason the `igdb` Edge Function exists.)
#
# Env vars are inlined at BUILD time: after editing, restart with
# `npx expo start --clear`. A hot reload will not pick up changes.

# --- Supabase (required) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Data API / API Keys
# The anon key is safe to ship: it is powerless without the Row Level Security
# policies defined in supabase/migrations/.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- IGDB (recommended) ----------------------------------------------------
# IGDB is the only source with true portrait box art, which the whole poster UI
# is built around. It needs a Twitch client_secret, which CANNOT ship in an app
# bundle — so nothing goes here. Instead the credentials live as Supabase Edge
# Function secrets:
#
#   1. Create an app at https://dev.twitch.tv/console/apps
#   2. supabase secrets set TWITCH_CLIENT_ID=xxx TWITCH_CLIENT_SECRET=yyy
#   3. supabase functions deploy igdb
#
# Set this to `false` to switch IGDB off (e.g. before the function is deployed,
# so search does not error on every keystroke). Any other value leaves it on.
EXPO_PUBLIC_IGDB_ENABLED=true

# --- RAWG (optional) -------------------------------------------------------
# Broad console coverage and per-game achievement lists. Free instant key at
# https://rawg.io/apidocs — a plain query-param key, no OAuth, so it can run
# client-side. Leave blank to skip RAWG entirely.
EXPO_PUBLIC_RAWG_API_KEY=

# --- Steam (optional) ------------------------------------------------------
# Search and game details need NO key — those endpoints are public.
# A key is only required for ACHIEVEMENTS (definitions + per-user unlock sync).
# Get one at https://steamcommunity.com/dev/apikey
#
# NOTE: this key is tied to your Steam account and will be visible in the app
# bundle. Fine for a private/class build; move it behind an Edge Function (like
# IGDB) before shipping publicly.
EXPO_PUBLIC_STEAM_API_KEY=

# --- itch.io (optional) ----------------------------------------------------
# Leave blank and itch.io results are simply skipped, nothing breaks.
# https://itch.io/user/settings/api-keys
# NOTE: this is a personal key. Development convenience only.
EXPO_PUBLIC_ITCH_API_KEY=
